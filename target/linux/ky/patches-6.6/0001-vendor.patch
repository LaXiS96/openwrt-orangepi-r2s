+	int err;
+
+	pdp_args.handle = args->handle;
+	pdp_args.pad = args->pad;
+	pdp_args.offset = args->offset;
+
+	err = pdp_gem_object_mmap_ioctl(dev, &pdp_args, file);
+
+	if (!err)
+		args->offset = pdp_args.offset;
+
+	return err;
+}
