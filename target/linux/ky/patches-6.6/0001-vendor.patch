+
+static struct ky_reset *to_ky_reset(
+	struct reset_controller_dev *rcdev)
+{
+	return container_of(rcdev, struct ky_reset, rcdev);
+}
+
+static u32 ky_reset_read(struct ky_reset *reset,
+	u32 id)
+{
+	void __iomem *base;
+	switch(reset->signals[id].type){
+		case RST_BASE_TYPE_MPMU:
+			base = reset->mpmu_base;
+			break;
+		case RST_BASE_TYPE_APMU:
+			base = reset->apmu_base;
+			break;
+		case RST_BASE_TYPE_APBC:
+			base = reset->apbc_base;
+			break;
+		case RST_BASE_TYPE_APBS:
+			base = reset->apbs_base;
+			break;
+		case RST_BASE_TYPE_CIU:
+			base = reset->ciu_base;
+			break;
+		case RST_BASE_TYPE_DCIU:
+			base = reset->dciu_base;
+			break;
+		case RST_BASE_TYPE_DDRC:
+			base = reset->ddrc_base;
+			break;
+		case RST_BASE_TYPE_AUDC:
+			base = reset->audio_ctrl_base;
+			break;
+		case RST_BASE_TYPE_APBC2:
+			base = reset->apbc2_base;
+			break;
+		case RST_BASE_TYPE_RCPU:
+			base = reset->rcpu_base;
+			break;
+		case RST_BASE_TYPE_RCPU2:
+			base = reset->rcpu2_base;
+			break;
+		default:
+			base = reset->apbc_base;
+			break;
+
+	}
+
+	return readl(base + reset->signals[id].offset);
+}
+
+static void ky_reset_write(struct ky_reset *reset, u32 value,
+	u32 id)
+{
+	void __iomem *base;
+	switch(reset->signals[id].type){
+		case RST_BASE_TYPE_MPMU:
+			base = reset->mpmu_base;
+			break;
+		case RST_BASE_TYPE_APMU:
+			base = reset->apmu_base;
+			break;
+		case RST_BASE_TYPE_APBC:
+			base = reset->apbc_base;
+			break;
+		case RST_BASE_TYPE_APBS:
+			base = reset->apbs_base;
+			break;
+		case RST_BASE_TYPE_CIU:
+			base = reset->ciu_base;
+			break;
+		case RST_BASE_TYPE_DCIU:
+			base = reset->dciu_base;
+			break;
+		case RST_BASE_TYPE_DDRC:
+			base = reset->ddrc_base;
+			break;
+		case RST_BASE_TYPE_AUDC:
+			base = reset->audio_ctrl_base;
+			break;
+		case RST_BASE_TYPE_APBC2:
+			base = reset->apbc2_base;
+			break;
+		case RST_BASE_TYPE_RCPU:
+			base = reset->rcpu_base;
+			break;
+		case RST_BASE_TYPE_RCPU2:
+			base = reset->rcpu2_base;
+			break;
+		default:
+			base = reset->apbc_base;
+			break;
+
+	}
+	writel(value, base + reset->signals[id].offset);
+}
+
+static void ky_reset_set(struct reset_controller_dev *rcdev,
+	u32 id, bool assert)
+{
+	u32 value;
+	struct ky_reset *reset = to_ky_reset(rcdev);
+
+	value = ky_reset_read(reset, id);
+	if(assert == true) {
+		value &= ~ reset->signals[id].mask;
+		value |=reset->signals[id].assert_val;
+
+	} else {
+		value &= ~reset->signals[id].mask;
+		value |= reset->signals[id].deassert_val;
+	}
+	ky_reset_write(reset, value, id);
+}
+
+static int ky_reset_update(struct reset_controller_dev *rcdev,
+	unsigned long id, bool assert)
+{
+	unsigned long flags;
+	struct ky_reset *reset = to_ky_reset(rcdev);
+
+	if(id < RESET_UART1 || id >= RESET_NUMBER)
+		return 0;
+
+	if (id == RESET_TWSI8)
+		return 0;
+
+	spin_lock_irqsave(reset->lock, flags);
+	if(assert == true){
+		ky_reset_set(rcdev, id, assert);
+	}
+	else{
+		ky_reset_set(rcdev, id, assert);
+	}
+	spin_unlock_irqrestore(reset->lock, flags);
+	return 0;
+}
+
+static int ky_reset_assert(struct reset_controller_dev *rcdev,
+	unsigned long id)
+{
+	return ky_reset_update(rcdev, id, true);
+}
+
+static int ky_reset_deassert(struct reset_controller_dev *rcdev,
+	unsigned long id)
+{
+	return ky_reset_update(rcdev, id, false);
+}
+
+static const struct ky_reset_variant x1_reset_data = {
+	.signals = x1_reset_signals,
+	.signals_num = ARRAY_SIZE(x1_reset_signals),
+	.ops = {
+		.assert   = ky_reset_assert,
+		.deassert = ky_reset_deassert,
+	},
+};
+
+static void ky_reset_init(struct device_node *np)
+{
+	struct ky_reset *reset;
+
+	//LOG_INFO("init reset");
+	if (of_device_is_compatible(np, "ky,x1-reset")){
+		reset = &x1_reset_controller;
+		reset->mpmu_base = of_iomap(np, 0);
+		if (!reset->mpmu_base) {
+			pr_err("failed to map mpmu registers\n");
+			goto out;
+		}
+
+		reset->apmu_base = of_iomap(np, 1);
+		if (!reset->apmu_base) {
+			pr_err("failed to map apmu registers\n");
+			goto out;
+		}
+
+		reset->apbc_base = of_iomap(np, 2);
+		if (!reset->apbc_base) {
+			pr_err("failed to map apbc registers\n");
+			goto out;
+		}
+
+		reset->apbs_base = of_iomap(np, 3);
+		if (!reset->apbs_base) {
+			pr_err("failed to map apbs registers\n");
+			goto out;
+		}
+
+		reset->ciu_base = of_iomap(np, 4);
+		if (!reset->ciu_base) {
+			pr_err("failed to map ciu registers\n");
+			goto out;
+		}
+
+		reset->dciu_base = of_iomap(np, 5);
+		if (!reset->dciu_base) {
+			pr_err("failed to map dragon ciu registers\n");
+			goto out;
+		}
+
+		reset->ddrc_base = of_iomap(np, 6);
+		if (!reset->ddrc_base) {
+			pr_err("failed to map ddrc registers\n");
+			goto out;
+		}
+
+		reset->apbc2_base = of_iomap(np, 7);
+		if (!reset->apbc2_base) {
+			pr_err("failed to map apbc2 registers\n");
+			goto out;
+		}
+
+		reset->rcpu_base = of_iomap(np, 8);
+		if (!reset->rcpu_base) {
+			pr_err("failed to map rcpu registers\n");
+			goto out;
+		}
+
+		reset->rcpu2_base = of_iomap(np, 9);
+		if (!reset->rcpu2_base) {
+			pr_err("failed to map rcpu2 registers\n");
+			goto out;
+		}
+	} else {
+		pr_err("not ky,x1-reset\n");
+		goto out;
+	}
+
+	reset->lock = &g_cru_lock;
+	reset->signals = x1_reset_data.signals;
+	reset->rcdev.owner     = THIS_MODULE;
+	reset->rcdev.nr_resets = x1_reset_data.signals_num;
+	reset->rcdev.ops       = &x1_reset_data.ops;
+	reset->rcdev.of_node   = np;
+	//LOG_INFO("register");
+	reset_controller_register(&reset->rcdev);
+out:
+	return;
+}
+
+CLK_OF_DECLARE(x1_reset, "ky,x1-reset", ky_reset_init);
