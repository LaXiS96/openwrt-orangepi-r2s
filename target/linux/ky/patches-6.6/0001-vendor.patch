+		status = "okay";
+	};
+
+	sound_hdmi: snd-card@0 {
+		compatible = "ky,simple-audio-card";
+		simple-audio-card,name = "snd-hdmi";
+		status = "disabled";
+		interconnects = <&dram_range4>;
+		interconnect-names = "dma-mem";
