+static int ky_dsi_phy_attach(struct ky_dsi *dsi)
+{
+	struct device *dev;
+
+	dev = ky_disp_pipe_get_output(&dsi->dev);
+	if (!dev)
+		return -ENODEV;
+
+	dsi->ctx.phy = dev_get_drvdata(dev);
+	if (!dsi->ctx.phy) {
+		DRM_ERROR("dsi attach phy failed\n");
+		return -EINVAL;
+	}
+
+	return 0;
+}
