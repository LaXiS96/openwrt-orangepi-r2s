+static int list_add_no_repeat(struct list_head *new, struct list_head *head)
+{
+	struct list_head *pos = NULL;
+
+	list_for_each(pos, head) {
+		if (pos == new)
+			return 1;
+	}
+	list_add(new, head);
+	return 0;
+}
