+	if ((eError == PVRSRV_OK) && !bCreated)
+	{
+		/* touch the allocation so it goes to the head of our MRU list */
+		TouchBusyAllocation(psDevHData, ui32AllocationIndex);
+	}
+	else if (eError != PVRSRV_OK)
