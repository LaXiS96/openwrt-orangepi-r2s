+	MVX_HWREG_IRQVE,
+	MVX_HWREG_CLKFORCE,
+	MVX_HWREG_FUSE,
+	MVX_HWREG_PROTCTRL,
+	MVX_HWREG_RESET,
+	MVX_HWREG_CONFIG,
+	MVX_HWREG_WHAT_MAX
+};
