+#define RGXFwSharedMemCacheOpValue(...) ((void)NULL)
+#define RGXFwSharedMemCacheOpPtr(...) ((void)NULL)
+#define RGXFwSharedMemCacheOpExecPfn NULL
+#define RGXFwSharedMemFlushCCB(...)
+#endif
