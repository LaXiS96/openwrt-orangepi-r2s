+	rmem_vaddr_start = phys_to_virt(rmem->base);
+	rmem_vaddr_end = phys_to_virt(rmem->base + rmem->size - 1);
+
+	free_reserved_area(rmem_vaddr_start, rmem_vaddr_end, -1, "framebuffer");
+
+	ky_dpu_free_logo = true;
+
+	return 0;
+}
