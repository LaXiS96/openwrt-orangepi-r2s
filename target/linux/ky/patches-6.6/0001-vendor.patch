+		struct mvx_fw_primary w;
+		unsigned int luminance_min;
+		unsigned int luminance_max;
+	} display;
+	struct {
+		unsigned int luminance_max;
+		unsigned int luminance_average;
+	} content;
+
+    uint8_t video_format;
+    uint8_t aspect_ratio_idc;
+    uint16_t sar_width;
+    uint16_t sar_height;
