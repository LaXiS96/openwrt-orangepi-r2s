+        unsigned int reserved1                : 4;      /**< Reserved */
+        unsigned int wdma_burst_len           : 5;      /**< set wdma burst length */
+        unsigned int reserved2                : 19;     /**< Reserved */
+    } field;                                            /**< Fields view */
+    unsigned int overlay;                               /**< Overlay view */
+} v2d_ctrl_reg_t;
