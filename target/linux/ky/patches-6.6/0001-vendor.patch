+void mvx_log_group_construct(struct mvx_log_group *group,
+			     const char *tag,
+			     const enum mvx_log_severity severity,
+			     struct mvx_log_drain *drain);
+
+/**
+ * mvx_log_group_add() - Add a group with given name to log.
+ * @log:		Pointer to log.
+ * @name:		Name of group.
+ * @group:		Pointer to group.
