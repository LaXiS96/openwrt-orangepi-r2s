+	ISP_IRQ_BIT_BINNING_SOF,
+	ISP_IRQ_BIT_DEMOSAIC_SOF,
+	ISP_IRQ_BIT_HDR_SOF,
+	ISP_IRQ_BIT_LTM_SOF,
+	ISP_IRQ_BIT_MCU_TRIGGER,
