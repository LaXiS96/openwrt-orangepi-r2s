+	MVX_FW_MATRIX_BT601,            /* Rec.ITU-R BT.601 625 */
+	MVX_FW_MATRIX_SMPTE240M,        /* SMPTE 240M or equivalent */
+	MVX_FW_MATRIX_BT2020,           /* Rec.ITU-R BT.2020 non-const lum */
+	MVX_FW_MATRIX_BT2020Constant    /* Rec.ITU-R BT.2020 const lum */
+};
