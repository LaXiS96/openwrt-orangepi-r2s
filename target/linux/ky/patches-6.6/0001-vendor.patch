+static const struct of_device_id x1cpp_dt_match[] = {
+	{
+		.compatible = "ky,x1cpp",
+		.data = &cpp_ops_2_0,
+	},
+	{}
+};
+
+MODULE_DEVICE_TABLE(of, x1cpp_dt_match);
