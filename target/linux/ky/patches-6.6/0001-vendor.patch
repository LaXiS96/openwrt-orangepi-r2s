+/* Device memory (including HP mapping) on base register 4 */
+#define SYS_DEV_MEM_PCI_BASENUM		(4)
+
+/* Device memory size */
+#define ONE_GB_IN_BYTES					(0x40000000ULL)
+#define SYS_DEV_MEM_REGION_SIZE \
+	(PLATO_MEMORY_SIZE_GIGABYTES * ONE_GB_IN_BYTES)
