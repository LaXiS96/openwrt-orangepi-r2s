+static struct x1_sdhci_platdata *ky_get_mmc_pdata(struct device *dev)
+{
+	struct x1_sdhci_platdata *pdata;
+
+	pdata = devm_kzalloc(dev, sizeof(*pdata), GFP_KERNEL);
+	if (!pdata)
+		return NULL;
+	return pdata;
+}
