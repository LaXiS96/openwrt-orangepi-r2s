+#define IOC_MAGIC		'c'
+#define TCM_MEM_SHOW		_IOR(IOC_MAGIC, 2, int)
+#define TCM_VA_TO_PA		_IOR(IOC_MAGIC, 4, int)
+#define TCM_REQUEST_MEM		_IOR(IOC_MAGIC, 5, int)
+#define TCM_RELEASE_MEM		_IOR(IOC_MAGIC, 6, int)
