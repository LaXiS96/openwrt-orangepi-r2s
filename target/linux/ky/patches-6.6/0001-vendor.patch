+static int svivi_try_fmt_vid_cap(struct file *file,void *priv,
+			struct v4l2_format *f) {
+	struct v4l2_pix_format_mplane *pix = &f->fmt.pix_mp;
+
+	vcam_info("----- in");
+
+	svivi_format_try(pix);
+
+	return 0;
+}
