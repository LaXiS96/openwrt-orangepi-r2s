+	if (!state) {
+		clk_prepare_enable(up->gclk);
+		clk_prepare_enable(up->fclk);
+	} else {
+		clk_disable_unprepare(up->fclk);
+		clk_disable_unprepare(up->gclk);
+	}
+}
