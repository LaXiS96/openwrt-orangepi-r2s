+void pdp_apollo_set_syncgen_enabled(struct device *dev, void __iomem *pdp_reg,
+				    bool enable)
+{
+	u32 value;
+
+#ifdef PDP_VERBOSE
+	dev_info(dev, "Set syncgen: %s\n", enable ? "enable" : "disable");
+#endif
