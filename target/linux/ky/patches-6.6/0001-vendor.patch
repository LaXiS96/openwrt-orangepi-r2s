+/* Standard module information, edit as appropriate */
+MODULE_LICENSE("GPL v2");
+MODULE_AUTHOR("KY Inc.");
+MODULE_DESCRIPTION("KY Camera Sensor Driver");
+
+#undef CAM_MODULE_TAG
+#define CAM_MODULE_TAG	CAM_MDL_SNR
