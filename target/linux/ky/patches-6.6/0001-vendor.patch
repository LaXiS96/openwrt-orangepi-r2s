+	(u32)(((v) & (u32)~(m)) | (u32)(((b) << (s)) & (m)))
+/* Active low */
+#define REG_VALUE_LO(v, b, s, m) \
+	(u32)((v) & ~(u32)(((b) << (s)) & (m)))
