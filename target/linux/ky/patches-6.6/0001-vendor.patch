+	dma_addr_t *dma_addr = (dma_addr_t*)vb2_plane_cookie(vb, plane_no);
+
+	BUG_ON(!ac_vnode);
+	offset = ac_vnode->planes_offset[vb->index][plane_no];
+	paddr = *dma_addr + offset;
