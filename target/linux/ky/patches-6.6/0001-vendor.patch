+	dev_dbg(dwc->dev, "phy/connector report vbus disconnected\n");
+	local_bh_disable();
+	spin_lock_irqsave(&dwc->lock, flags);
+	dwc3_gadget_disconnect_interrupt(dwc);
+	spin_unlock_irqrestore(&dwc->lock, flags);
+	local_bh_enable();
+
+	return 0;
+}
