+		status = "disabled";
+		interconnects = <&dram_range4>;
+		interconnect-names = "dma-mem";
+		ky,init-jack;
+		simple-audio-card,cpu {
+			sound-dai = <&i2s0>;
+		};
+		simple-audio-card,plat {
+			sound-dai = <&i2s0_dma>;
+		};
+	};
+};
