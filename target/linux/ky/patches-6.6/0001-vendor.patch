+ *
+ * Copyright(C) 2023 KY Micro Limited
+ */
+#ifndef __CAM_DBG_H__
+#define __CAM_DBG_H__
+
+#include <linux/printk.h>
+
+enum dbg_module_tag {
+	CAM_MDL_VI = 0,
+	CAM_MDL_ISP = 1,
+	CAM_MDL_CPP = 2,
+	CAM_MDL_VBE = 3,
+	CAM_MDL_SNR = 4,
+	CAM_MDL_IRCUT = 5,
+	CAM_MDL_COMMON = 8,
+};
+
+#ifndef CAM_MODULE_TAG
+#define CAM_MODULE_TAG CAM_MDL_COMMON
+#endif
