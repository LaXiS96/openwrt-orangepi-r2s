+	value = pdp_rreg32(pdp_reg, TCF_RGBPDP_PVR_TCF_RGBPDP_SYNCCTRL);
+	value = REG_VALUE_SET(value, enable ? 0x1 : 0x0,
+			      SYNCACTIVE_SHIFT, SYNCACTIVE_MASK);
+	pdp_wreg32(pdp_reg, TCF_RGBPDP_PVR_TCF_RGBPDP_SYNCCTRL, value);
