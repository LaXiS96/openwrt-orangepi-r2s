+static int x1_power_on(struct x1_pcie *x1, int on)
+{
+	bool status = on ? 1 : 0;
+
+	if (x1->pwr_on_gpio <= 0) {
+		return 0;
+	}
+
+	dev_info(x1->pci->dev, "set power on gpio %d to %d\n", x1->pwr_on_gpio, status);
+	gpio_direction_output(x1->pwr_on_gpio, status);
+	return 0;
+}
