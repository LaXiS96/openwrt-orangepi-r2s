+#define V4L2_PIX_FMT_D010_1	v4l2_fourcc('D', '0', '1', '1')
+#define V4L2_PIX_FMT_D010_2	v4l2_fourcc('D', '0', '1', '2')
+#define V4L2_PIX_FMT_D010_3	v4l2_fourcc('D', '0', '1', '3')
