+ ****************************************************************************/
+
+void mvx_hwreg_get_formats_v500(enum mvx_direction direction,
+				uint64_t *formats)
+{
+	if (direction == MVX_DIR_INPUT) {
+		mvx_set_bit(MVX_FORMAT_H263, formats);
+		mvx_set_bit(MVX_FORMAT_H264, formats);
