+ * wbK_L3------TBU31
+ */
+#define MMU_TBU(tbu_id) ((tbu_id) << 16)
+static const uint32_t iommu_ch_tid_map[] = {
+	MMU_TID(MAC_DMA_PORT_W0, MAC_DMA_CHNL_DWT_Y_L4) | MMU_TBU(0),
+	MMU_TID(MAC_DMA_PORT_W0, MAC_DMA_CHNL_DWT_C_L4) | MMU_TBU(1),
