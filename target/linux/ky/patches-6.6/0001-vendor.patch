+		OSFreeMem(psDevInfo->sDevFeatureCfg.pszBVNCString);
+	}
+
+
+	/* DeAllocate devinfo */
+	OSFreeMem(psDevInfo);
+
+	psDeviceNode->pvDevice = NULL;
+
+	return PVRSRV_OK;
+}
