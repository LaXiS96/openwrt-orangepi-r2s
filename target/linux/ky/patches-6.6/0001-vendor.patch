+static int ccic_dma_shadow_ready(struct ccic_dma *dma_dev)
+{
+	struct ccic_dev *ccic_dev = dma_dev->ccic_dev;
+	ccic_reg_set_bit(ccic_dev, REG_CTRL1, C1_SHADOW_RDY);
+
+	return 0;
