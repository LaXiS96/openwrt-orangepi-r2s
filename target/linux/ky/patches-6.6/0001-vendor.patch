+#define SUBDEV_GRP_MASK		(0xff0000)
+#define SUBDEV_GRP_OFFSET	(16)
+
+#define SD_GRP_ID(grp, sub, id)	(((grp) << SUBDEV_GRP_OFFSET) | ((sub) << SUBDEV_SUBGRP_OFFSET) | (id))
