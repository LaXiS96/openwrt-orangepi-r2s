+static int crypto_engine_select(int index, CRYPTO_ENG_SEL_T engine)
+{
+	uint32_t val;
+
+	val = crypto_read32(index, CE_CRYPTO_ENGINE_SEL_REG);
+	val &= ~0x3;
+
+	switch (engine) {
+	case E_ENG_AES:
+		val |= (0x1);
+		break;
+	default:
+		return -EINVAL;
+	}
+
+	crypto_write32(index, CE_CRYPTO_ENGINE_SEL_REG, val);
+
+	return 0;
+}
