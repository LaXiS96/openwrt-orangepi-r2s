+static int dpu_update_bw(struct ky_dpu *dpu, uint64_t bw)
+{
+	uint64_t __maybe_unused tmp;
+
+	trace_u64_data("update bw", bw);
+
+	if (dpu->cur_bw == bw)
+		return 0;
+
+	return 0;
+}
