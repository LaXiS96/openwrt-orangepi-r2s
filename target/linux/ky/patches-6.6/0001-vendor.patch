+				}
+			} else {
+				cam_err("dovdd is NULL!");
+				return -EINVAL;
+			}
+			break;
+		case SENSOR_REGULATOR_DVDD:
+			if (!IS_ERR_OR_NULL(msnr_dev->dvdd)) {
