+#define REG_IOMMU_TIMEOUT_ADDR_HIGH	(0x12238)
+#define REG_IOMMU_VER		(0x1223c)
+
+#define MMU_RD_TIMEOUT		(1 << 16)
+#define MMU_WR_TIMEOUT		(1 << 17)
