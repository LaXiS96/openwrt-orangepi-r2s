+		return PTR_ERR(lt9711->dsi);
+	}
+
+	//check i2c communicate
+	ret = lt9711_i2c_detect(lt9711);
+	if (ret < 0) {
+		DRM_INFO("detect DP failed communicate with IC use I2C\n");
+		return ret;
+	}
