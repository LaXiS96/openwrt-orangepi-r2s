+						return -EFAULT;
+#ifdef CONFIG_KY_CAPT_DEBUG
+		if ((dump_id & (1 << (2 * dmadata->dma_id + 1)))) {
+			ky_debug_data(hwbuf, &dmadata->capt_buf, &dmadata->debug_flag, &dmadata->capt_flag, runtime,
