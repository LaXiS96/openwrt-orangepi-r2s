+#define DPHY_ESCCLK_DEFAULT	51200000
+
+enum ky_dphy_lane_map {
+	DPHY_LANE_MAP_0123 = 0,
+	DPHY_LANE_MAP_0312 = 1,
+	DPHY_LANE_MAP_0231 = 2,
+	DPHY_LANE_MAP_MAX
